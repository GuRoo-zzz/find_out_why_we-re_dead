#----------定義投資----------------#


def chance():
  global HP
  global Life
  probs = ['1', '2', '3', '4']
  p = random.randint(0, 3)
  prob = probs[p]

  if int(prob) != 1:
    print('哦歐，你沒錢了！不過別擔心，你的好夥伴在投資中賺了一筆，贊助了你100萬~')
    HP += 1000000
    Life -= 1
  else:
    print('你沒錢了，但你的夥伴投資失敗了…')
    gameOver()


